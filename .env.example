# Copie para .env e ajuste. O docker-compose lê este arquivo automaticamente.

# Segredo HS512 compartilhado entre back-end e auth-microservice (>= 64 bytes).
# Gere com: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=troque-por-um-segredo-forte-com-pelo-menos-64-bytes-0123456789abcdefghijklmnop

# Postgres (superusuário do container e senhas dos usuários de cada serviço)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
FILMAE_DB_PASSWORD=filmae_password
AUTH_DB_PASSWORD=auth_password

# Perfil do back-end no compose (dev carrega o seed de filmes de db/seed)
BACKEND_PROFILE=dev

# Execução local fora do Docker (mvn spring-boot:run)
DATABASE_URL=jdbc:postgresql://localhost:5432/filmae_db
DATABASE_USERNAME=filmae_user
DATABASE_PASSWORD=filmae_password
AUTH_SERVICE_BASE_URL=http://localhost:8081
CORS_ALLOWED_ORIGIN_PATTERNS=*
